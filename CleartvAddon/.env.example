# ClearTV addon — local development configuration.
# Copy to .env and adjust. Nothing here is deployed anywhere.

# ── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=7100

# Public URL of this addon. For local testing this is just localhost — the
# configure page builds install links from it.
BASE_URL=http://127.0.0.1:7100

# ── Leaf node (required) ──────────────────────────────────────────────────────
# The leaf node that owns the channels. Point this at your own local leaf.
# dev/fake_leaf.py serves a stub catalog on 8087 for testing without a real one.
LEAF_BASE_URL=http://127.0.0.1:8087

# Paths on the leaf node. Defaults match the leaf bridge's own routes.
LEAF_CATALOG_PATH=/leaf/catalog.json
LEAF_HEALTH_PATH=/leaf/health

# Optional bearer token, if your leaf restricts its catalog.
LEAF_API_KEY=

# Set only if the leaf advertises an address clients cannot reach, e.g. it
# reports an internal host but you want playlists fetched over a public name.
# Leave empty to use the leaf's URLs verbatim (normal case).
LEAF_PUBLIC_URL=

LEAF_TIMEOUT=10
# Set false only for a leaf using a self-signed certificate.
LEAF_VERIFY_TLS=true

# ── Refresh / cache ───────────────────────────────────────────────────────────
REFRESH_INTERVAL=45
REFRESH_RETRY_INTERVAL=15
# Must be greater than REFRESH_INTERVAL — the addon refuses to start otherwise.
CACHE_TTL=180

# ── Addon identity ────────────────────────────────────────────────────────────
ADDON_ID=top.nowclear.cleartv
ADDON_NAME=ClearTV
ADDON_VERSION=1.0.0
ADDON_DESCRIPTION=Live TV channels, streamed clean and direct.
ADDON_LOGO=
ADDON_BACKGROUND=

# ── Catalog ───────────────────────────────────────────────────────────────────
CATALOG_NAME=Live TV
PAGE_SIZE=100
DEFAULT_CATEGORY=General
SHOW_BUFFERING_DEFAULT=true

# Comma-separated slugs to hide regardless of what the leaf reports.
BLOCKED_SLUGS=

# Poster used when a channel has no artwork.
FALLBACK_POSTER=

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=240
RATE_LIMIT_WINDOW=60
RATE_LIMIT_BYPASS_IPS=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
