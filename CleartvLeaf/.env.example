# ClearTV leaf — local development configuration.
# Copy to .env and adjust. Nothing here is deployed anywhere.

# ── Server ────────────────────────────────────────────────────────────────────
LEAF_HOST=127.0.0.1
LEAF_PORT=8090

# Public base URL of this leaf. Goes into playlist_url in the catalog and into
# every rewritten segment link, so it must be reachable by the addon and by
# players. For local testing, localhost is correct.
LEAF_PUBLIC_URL=http://127.0.0.1:8090

# ── Admin panel (required) ────────────────────────────────────────────────────
# No default. The panel holds provider credentials and controls what users can
# watch, so the leaf refuses to start without one. Minimum 8 characters.
ADMIN_PASSWORD=change-me-please

# Session lifetime in seconds (default 24h).
ADMIN_SESSION_TTL=86400

# Set true ONLY when serving the panel over HTTPS. It marks the session cookie
# Secure, which browsers then refuse to send over plain HTTP.
ADMIN_COOKIE_SECURE=false

# Failed-login throttle, per IP.
ADMIN_LOGIN_MAX_ATTEMPTS=8
ADMIN_LOGIN_WINDOW=300

# ── Catalog access ────────────────────────────────────────────────────────────
# Optional bearer token the addon must send to read /leaf/catalog.json.
# Empty means anyone who can reach this leaf can read the channel list.
# If set, put the same value in the addon's LEAF_API_KEY.
CATALOG_API_KEY=

# ── Segment relay ─────────────────────────────────────────────────────────────
# Signs the /seg/ links that replace provider URLs in playlists. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Leave empty and a random one is used per run — fine locally, but every restart
# invalidates links players are already holding.
SEGMENT_SECRET=

# How long a signed segment link stays valid (seconds).
SEGMENT_TTL=120

# Playlist cache window. Collapses concurrent viewers into one upstream fetch.
PLAYLIST_CACHE_TTL=2.0

# Segment cache: retention and total memory cap.
SEGMENT_CACHE_TTL=30.0
SEGMENT_CACHE_MAX_MB=256

# ── Upstream provider ─────────────────────────────────────────────────────────
UPSTREAM_TIMEOUT=15
UPSTREAM_USER_AGENT=okhttp/5.0.0-alpha.2

# Most Xtream panels have broken or self-signed certificates, so verification is
# off by default. Credentials still travel over TLS, just unvalidated.
UPSTREAM_VERIFY_TLS=false

# ── Caches / refresh ──────────────────────────────────────────────────────────
# Provider channel lists are large and rarely change.
CHANNEL_CACHE_TTL=14400

# How often account status/expiry is re-checked against the provider.
ACCOUNT_INFO_INTERVAL=1800

# ── Storage ───────────────────────────────────────────────────────────────────
# accounts.json (chmod 600, holds provider credentials) and channels.json live here.
DATA_DIR=data

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
